<Project Sdk="Microsoft.NET.Sdk">
  <!-- Round 35 T25 enum-gap probe: the by-value enum row's two generated methods, alone, under BenchmarkDotNet (run.sh).
       Not in the solution. Takes the repository's own BenchmarkDotNet pin. Warnings stay warnings and the repository's
       code-style gate is off: this is a probe, not product code. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>
</Project>
