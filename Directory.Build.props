<!-- SPDX-License-Identifier: GPL-2.0-only -->
<Project>
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningsNotAsErrors></WarningsNotAsErrors>

        <!-- Static analysis: maximum, defensive from the start -->
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest-all</AnalysisLevel>
        <AnalysisMode>All</AnalysisMode>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

        <!-- Round 31 T26: Dwarf.Map calls are bound at compile time by interceptors the generator emits into
             DwarfMapper.Generated. Package consumers get this from the package's build/DwarfMapper.props; the
             projects in this repository reference src/DwarfMapper by PROJECT, which does not import that file, so
             the same line is stated here. -->
        <InterceptorsNamespaces>$(InterceptorsNamespaces);DwarfMapper.Generated</InterceptorsNamespaces>

        <!-- Reproducible / CRA: deterministic builds, source link -->
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <!-- Supply-chain gate (round-22 S1): vulnerability audit + repeatable restores.
             NuGetAudit checks every restore against the advisory database; mode `all` audits TRANSITIVE
             packages too, level `low` audits every severity. The pinned SDK already defaults the mode to
             `all` via SdkAnalysisLevel — stating all three pins the gate against SDK-default drift, the
             same reason the SDK itself is pinned. Restore honors TreatWarningsAsErrors above, so every
             NU1901–NU1904 advisory FAILS the restore; NU1900/NU1905 (audit could not run / no source
             provides vulnerability data) stay errors too on purpose — an audit that silently could not
             fetch its database is a vacuous green, the exact genre Assert-MutantsWereTested exists for. -->
        <NuGetAudit>true</NuGetAudit>
        <!-- The one exception: the offline image Anthropic's OSS Scanner audits in (.oss-scanner/Dockerfile) runs this
             audit ONLINE while it is built, then declares itself with DWARFMAPPER_OFFLINE_IMAGE=true for an agent that
             has no network - where every restore that is not a no-op (a new project, or a project restored on its own
             rather than through the solution) would otherwise fail NU1900. An environment variable reaches every
             evaluation in every node, which a response file does not. No workflow or script sets it, and no workflow
             or script switches the audit off any other way; OssScannerImageTests holds both. -->
        <NuGetAudit Condition="'$(DWARFMAPPER_OFFLINE_IMAGE)' == 'true'">false</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <NuGetAuditLevel>low</NuGetAuditLevel>

        <!-- Lock files make the resolved package graph a COMMITTED, diffable artifact per project; CI and
             housekeeping restore in locked mode (RestoreLockedMode below fires on CI's env var), so a
             restore that would resolve anything other than the committed graph fails NU1004 loudly instead
             of silently compiling against different bytes. Central package management pins the versions;
             the lock files pin the resolved GRAPH + content hashes — reproducibility proof, not redundancy.
             After an intentional dependency change, regenerate with `dotnet restore` + force-evaluate. -->
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>

        <!-- Package metadata (license is unambiguous in every artifact) -->
        <Authors>DwarfMapper contributors</Authors>
        <Company>DwarfMapper contributors</Company>
        <Copyright>Copyright (c) DwarfMapper contributors</Copyright>
        <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
        <!-- Strong copyleft: require explicit license acceptance on install for every produced package
             (DwarfMapper, DwarfMapper.Generator, DwarfMapper.Testing). -->
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <PackageProjectUrl>https://github.com/GimliCZ/DwarfMapper.NET</PackageProjectUrl>
        <RepositoryUrl>https://github.com/GimliCZ/DwarfMapper.NET</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>mapper;mapping;source-generator;roslyn;aot;dto;blittable;simd</PackageTags>

        <!-- Version: overridable by CI from the release tag (-p:Version=x.y.z).
             Keep in sync with the README 'Status' section. -->
        <Version Condition="'$(Version)' == ''">1.0.2-rc.1</Version>
    </PropertyGroup>
</Project>
