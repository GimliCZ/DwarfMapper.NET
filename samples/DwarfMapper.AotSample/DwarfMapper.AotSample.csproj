<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <PublishAot>true</PublishAot>
        <IsPackable>false</IsPackable>
        <!-- Both RIDs ci.yml's aot-trim-gate publishes with. A RID-targeted restore resolves a
             RID-specific graph, and locked-mode restore (round-22 S1) refuses NU1004 any graph the
             committed packages.lock.json does not carry — declaring the RIDs here writes both graphs
             into the lock file at generation time. -->
        <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
        <!-- CA1515: a single-file sample's types are public in an exe that exposes no API.
             CA1303: the lines it prints are fixed strings for the AOT gate's log, not localizable UI. -->
        <!-- CA2007 + MA0004 (ConfigureAwait): not needed in a self-contained sample app's await foreach.
             Same ruling, one rule from the .NET analyzers and its Meziantou twin.
             CA1819 (array-returning properties): intentional for the SIMD-widen array gate. -->
        <NoWarn>$(NoWarn);CA1515;CA1303;CA2007;MA0004;CA1819</NoWarn>
        <!-- DWARF038 is downgraded in this project's .globalconfig, with its reason, per the 2026-09-27 ruling
             (no DWARF id in a NoWarn). DWARF044 was here too and suppressed nothing (round 34's audit). -->
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\DwarfMapper\DwarfMapper.csproj"/>
        <ProjectReference Include="..\..\src\DwarfMapper.Generator\DwarfMapper.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>
</Project>
