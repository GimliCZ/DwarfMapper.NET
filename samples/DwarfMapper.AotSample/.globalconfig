# SPDX-License-Identifier: GPL-2.0-only
# Project-scoped global analyzer config for the AOT sample. Additive to the repo-root and samples/ files (the SDK
# discovers every .globalconfig above a compiled file); never repeat a key either of them sets, because an equal
# global_level conflict DROPS the key from both. A DWARF diagnostic is downgraded here rather than in the
# project's <NoWarn> (owner ruling 2026-09-27): this is the mechanism the docs give consumers, and the one that can
# also escalate.
is_global = true

# DWARF038 (implicit conversion applied): this sample DELIBERATELY exercises the narrowing (long→int) and
# parse/format (string↔int/Guid) conversion paths to prove they are AOT-safe; that is the point of NarrowMapper,
# StringToIntAotMapper and the record's Score. The diagnostic is correct to flag them, and making them explicit
# would defeat the sample, so it is downgraded here only. Six sites, all in Program.cs.
dotnet_diagnostic.DWARF038.severity = none
