<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <!-- CA1051 (visible instance fields) and CA1815 (struct should override Equals) are suppressed for
             the blittable example: public fields in a plain unmanaged struct are exactly the shape the
             bulk-copy proof is about, and adding Equals/operators would obscure the layout being
             demonstrated. -->
        <!-- A gallery of examples to read. CA1515: each example's types are public, as a consumer's are.
             CA1303: the few lines it prints are fixed strings. CA1819/CA2227/CA1002: the collection examples use
             arrays, settable collections and List<T> exactly as the consumer DTOs they illustrate do.
             CA1861: one constant array argument in 05_Collections. CA1822: 40_BeforeAfterHooks declares its
             [BeforeMap] hook as an instance method on the mapper, the way a consumer writes one. -->
        <NoWarn>$(NoWarn);CA1303;CA1515;CA1819;CA2227;CA1002;CA1861;CA1822;CA1051;CA1815</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\DwarfMapper\DwarfMapper.csproj"/>
        <!-- Test-time only, for examples 25-26 ([RoundTrip] verification and informed dumps). Reflection-based
             and never AOT-published; the mapper itself stays reflection-free. Without this reference
             [RoundTrip] is a no-op. -->
        <ProjectReference Include="..\..\src\DwarfMapper.Testing\DwarfMapper.Testing.csproj"/>
        <ProjectReference Include="..\..\src\DwarfMapper.Generator\DwarfMapper.Generator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <!-- Only for the last example (DI). Centrally versioned in Directory.Packages.props. -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    </ItemGroup>
</Project>
