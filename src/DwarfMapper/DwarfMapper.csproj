<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>
        <!-- Restore-graph metadata only, nothing in the shipped package changes. The AOT samples publish
             with `-r linux-x64|win-x64`, whose restore re-evaluates this whole P2P closure under that
             global RID; locked-mode restore (round-22 S1) refuses NU1004 any RID graph the committed
             packages.lock.json lacks, so every project in the AOT publish closure declares both RIDs and
             its lock file carries both graphs. Same declaration in Generator/CodeFixes and both samples. -->
        <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>DwarfMapper — a compile-time object mapper for .NET where an unmapped member is a build error, maps are round-trip-verifiable (opt in with [RoundTrip]), and blittable data falls back to SIMD/blittable bulk copy. The shipped runtime library uses zero reflection and is NativeAOT- and trim-safe. This single package bundles the attributes, the Roslyn source generator, and the IDE code fixes — just reference it.</Description>
        <!-- PackageRequireLicenseAcceptance is set for all packages in Directory.Build.props. -->
        <!-- Deep-tier hook: every pack is validated against the latest published rc on nuget.org, so an
             accidental API break is caught at pack time. Intentional rc-phase breaks go into
             CompatibilitySuppressions.xml with a reason, or bump the baseline.

             DO NOT reintroduce <ApiCompatSuppressionFile>...</ApiCompatSuppressionFile> HERE. That is the
             property-vs-item trap (round 23, I15): the SDK reads ApiCompatSuppressionFile as an ITEM, not
             as a property — Microsoft.NET.ApiCompat.ValidatePackage.targets passes
             SuppressionFiles="@(ApiCompatSuppressionFile)", and Microsoft.NET.ApiCompat.Common.targets
             defaults that ITEM to $(MSBuildProjectDirectory)/CompatibilitySuppressions.xml (or to the
             legacy PROPERTY $(CompatibilitySuppressionFilePath), if that one is set). A same-named
             PROPERTY is simply never read: no warning, no error — the suppressions do not load and
             `dotnet pack` fails on a break that IS suppressed on disk, three lines above. That is
             precisely what shipped between round 21 and round 23, unnoticed because `dotnet pack` runs
             in exactly one place, release.yml, on a version tag.

             The file therefore sits at the SDK's DEFAULT name and needs no wiring at all — the remedy
             with the fewest moving parts, and the only one that keeps the SDK's own remediation advice
             working in place: the CP0006 message tells you to rebuild with
             /p:ApiCompatGenerateSuppressionFile=true, which WRITES to that same default name. If a
             non-default name is ever genuinely wanted, declare
             <ItemGroup><ApiCompatSuppressionFile Include="..."/></ItemGroup> — an item, never a
             property. -->
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>1.0.2-rc.1</PackageValidationBaselineVersion>
    </PropertyGroup>

    <!--
      Single-package delivery: bundle the source generator AND the code-fix providers into this package's
      analyzer slot, so a consumer only needs ONE reference:

          <PackageReference Include="DwarfMapper" Version="..." />

      No manual OutputItemType="Analyzer" wiring, no separate DwarfMapper.Generator reference. The
      ProjectReferences exist only to build those analyzer assemblies first (ReferenceOutputAssembly="false" so
      their output is not a compile reference, and SkipGetTargetFrameworkProperties so the netstandard2.0 -> net10
      reference raises no framework-compat warning; they are deliberately NOT loaded as analyzers on this
      attribute-only project). The <None Pack> items then place their DLLs under analyzers/dotnet/cs in the
      produced .nupkg. PrivateAssets="all" stops the reference flowing transitively through ProjectReference
      inside this repo, so the test/sample projects keep their own explicit analyzer references and nothing is
      applied twice.
    -->
    <ItemGroup>
        <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all"/>
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Include="PublicAPI.Shipped.txt"/>
        <AdditionalFiles Include="PublicAPI.Unshipped.txt"/>
        <AdditionalFiles Include="BannedSymbols.txt"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DwarfMapper.Generator\DwarfMapper.Generator.csproj"
                          ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" PrivateAssets="all"/>
        <ProjectReference Include="..\DwarfMapper.CodeFixes\DwarfMapper.CodeFixes.csproj"
                          ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\DwarfMapper.Generator\bin\$(Configuration)\netstandard2.0\DwarfMapper.Generator.dll"
              Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
        <None Include="..\DwarfMapper.CodeFixes\bin\$(Configuration)\netstandard2.0\DwarfMapper.CodeFixes.dll"
              Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    </ItemGroup>
</Project>
