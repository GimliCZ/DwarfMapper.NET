<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <!-- CA1707: test methods intentionally use underscores -->
        <!-- CA1515: test types need not be sealed -->
        <!-- CA2227/CA1002/CA1819: the shapes are DTOs, deliberately written the way real DTOs are written —
             settable collection properties and arrays are the point, not an oversight to be linted away. -->
        <!-- CA1861: MemberComparerTests passes two constant arrays inline, once each per case. -->
        <NoWarn>$(NoWarn);CA1707;CA1515;CA2227;CA1002;CA1819;CA1861</NoWarn>
        <!-- NU1903: AutoMapper 14.0.0 (the last MIT/GPL-compatible release; v15+ is RPL-1.5) carries a known
             advisory. This is a TEST-ONLY, non-shipped project (IsPackable=false) mapping in-memory POCOs with
             no untrusted input, so the advisory is not exercised, and the shipped library does not reference
             AutoMapper at all. Same reasoning and same suppression as the benchmark project. -->
    </PropertyGroup>
    <ItemGroup>
        <!-- AutoMapper 14.0.0 (last MIT release, benchmark/differential only): CVE-2026-32933 uncontrolled recursion. -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
        <!-- AutoMapper 14.0.0 again, both published 2026-11-13 and both the same failure class - recursion that the
             MaxDepth mitigation for CVE-2026-32933 does not stop: through constructor parameters and positional
             records (CVE-2026-128082), and through derived maps, interface-typed members, dictionary sources and
             recursive converters (CVE-2026-128081). Fixed only in 15.1.4 and 16.3.0, which are RPL-1.5 and cannot be
             referenced from this GPL-2.0-only repository; 14.0.0 stays the comparison oracle and ships nowhere.
             Suppressed by advisory, as above, so the next one fails the restore as these two did. What DwarfMapper
             itself does with those shapes is held by DeepRecursionGuardRuntimeTests. -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-6vhm-j9h7-f9gh" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gpwp-5797-mjff" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="JunitXml.TestLogger"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
        <PackageReference Include="coverlet.collector"/>
        <!-- The oracles. Mapperly is a source generator like DwarfMapper, so it is referenced as an analyzer;
             AutoMapper is a runtime library. Both licence-compatible — see Directory.Packages.props. -->
        <PackageReference Include="Riok.Mapperly" ExcludeAssets="runtime" PrivateAssets="all"/>
        <PackageReference Include="AutoMapper"/>
        <!-- Mapster is a THIRD oracle, added 2026-08-26 for the enum-order question. docs/COMPARISON.md
             publishes a Mapster column, so its enum semantics are a claim this repo makes and must therefore
             be measured rather than inferred from a timing that merely looks switch-shaped. MIT. -->
        <PackageReference Include="Mapster"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\DwarfMapper\DwarfMapper.csproj"/>
        <ProjectReference Include="..\..\src\DwarfMapper.Generator\DwarfMapper.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>
</Project>
