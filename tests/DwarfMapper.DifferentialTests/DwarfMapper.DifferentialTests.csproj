<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <!-- CA1707: test methods intentionally use underscores -->
        <!-- CA1515: test types need not be sealed -->
        <!-- CA2227/CA1002/CA1819: the shapes are DTOs, deliberately written the way real DTOs are written —
             settable collection properties and arrays are the point, not an oversight to be linted away. -->
        <NoWarn>$(NoWarn);CA1707;CA1515;CA2227;CA1002;CA1819;CA1861</NoWarn>
        <!-- NU1903: AutoMapper 14.0.0 (the last MIT/GPL-compatible release; v15+ is RPL-1.5) carries a known
             advisory. This is a TEST-ONLY, non-shipped project (IsPackable=false) mapping in-memory POCOs with
             no untrusted input, so the advisory is not exercised, and the shipped library does not reference
             AutoMapper at all. Same reasoning and same suppression as the benchmark project. -->
        <NoWarn>$(NoWarn);NU1903</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
        <!-- The oracles. Mapperly is a source generator like DwarfMapper, so it is referenced as an analyzer;
             AutoMapper is a runtime library. Both licence-compatible — see Directory.Packages.props. -->
        <PackageReference Include="Riok.Mapperly" ExcludeAssets="runtime" PrivateAssets="all"/>
        <PackageReference Include="AutoMapper"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\DwarfMapper\DwarfMapper.csproj"/>
        <ProjectReference Include="..\..\src\DwarfMapper.Generator\DwarfMapper.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>
</Project>
