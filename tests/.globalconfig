# SPDX-License-Identifier: GPL-2.0-only
# Test-scoped global analyzer config (round-22 W7, Meziantou phase 2). The SDK discovers EVERY .globalconfig
# in every directory above a compiled file, so this file is ADDITIVE to the repo-root one and applies only to
# projects whose sources live under tests/. Never repeat a key the root file sets: both files sit at the
# default global_level 100, and an equal-level conflict DROPS the key from both — silently re-enabling the
# rule instead of disabling it. Every disable below names the idiom it fights; do not add one without.
is_global = true

# MA0002 (use an overload that takes IEqualityComparer<string>/IComparer<string>): 149 sites, two idioms.
# (1) xunit assertions — Assert.Contains/DoesNotContain/Equal/NotEqual over string sequences. xunit's default
# string equality is ALREADY ordinal, so the comparer overload changes no behaviour and makes every assertion
# longer; ".editorconfig: strictness that degrades the code is not strictness worth having" applies verbatim.
# (2) Dictionary<string, …> fixture and corpus DTOs, which exist to mirror what a consumer writes — and whose
# comparer is itself the subject under test in the CaseInsensitive suites, so pinning one changes the
# experiment. The ordering sub-genre this rule also covers was REAL and was NOT suppressed: OrderBy over
# strings sorts by the CURRENT CULTURE, and all 15 such sites were fixed to StringComparer.Ordinal in the
# commit before this file was written. src keeps MA0002 on (T1 fixed 9 sites there).
dotnet_diagnostic.MA0002.severity = none

# MA0009 (regular expressions should not be vulnerable to denial of service — i.e. pass a match timeout):
# 44 sites, all in the self-validation source scanners, which read repo-controlled files: there is no
# untrusted input to ReDoS. A timeout would also put a WALL CLOCK inside a deterministic gate, and H7's
# standing rule is that no detection may ride a wall clock — a scanner that throws
# RegexMatchTimeoutException on a loaded machine is a flaky gate, not a safer one. src keeps MA0009 on;
# T1 gave DocTooling's Regex.Replace a 1 s timeout there because it processes files a consumer supplies.
dotnet_diagnostic.MA0009.severity = none

# MA0008 (add StructLayoutAttribute): 17 sites, all blit/span fixture structs. Annotating them is not
# cosmetic — src/DwarfMapper.Generator/Pipeline/BlittableProof.cs refuses the auto-blit path for ANY struct
# that carries [StructLayout] ("an absent [StructLayout] reliably means the C# default (Sequential)"), so
# adding the attribute would change WHICH CODE PATH the test measures. The fixtures must stay exactly what a
# consumer writes. src keeps MA0008 on (T1 gave EnumPolicy [StructLayout(LayoutKind.Auto)]).
dotnet_diagnostic.MA0008.severity = none
