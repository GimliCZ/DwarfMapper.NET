# SPDX-License-Identifier: GPL-2.0-only
# Root global analyzer config (auto-discovered by the SDK). The hand-curated .editorconfig stays
# authoritative for code style; this file carries only analyzer-package rule overrides that apply
# repo-wide. Every disable below has a one-line reason - do not add one without.
is_global = true

# MA0048 (file name must match type name): the generator deliberately splits partial classes
# (DwarfGenerator, emitters) across many files organised by concern, not by type name.
dotnet_diagnostic.MA0048.severity = none

# MA0051 (method is too long): emitter methods are long by design - a generated-code template
# reads top-to-bottom as the shape of its output; slicing it destroys that readability.
dotnet_diagnostic.MA0051.severity = none

# MA0026 (fix TODO comment): TODOs are tracked deliberately in TASKS/Issues; a build error on the
# word TODO would just drive them out of the code where they are most visible.
dotnet_diagnostic.MA0026.severity = none

# MA0003 (add argument name): the emitters call uniform multi-parameter emit/write signatures
# hundreds of times; naming every literal argument fights that idiom instead of helping it.
dotnet_diagnostic.MA0003.severity = none

# MA0006 (use string.Equals instead of == operator): NOT in the adoption plan's pre-approved list -
# added during triage (130 sites, reported). C#'s string ==/!= is compile-time-bound ordinal
# comparison and null-safe; `name == "literal"` on symbol names is the pervasive generator idiom, and
# rewriting every site to string.Equals(x, y, StringComparison.Ordinal) changes zero behaviour while
# obscuring the comparison the language already guarantees. Where a comparer is actually selectable
# (collections, LINQ Contains, GetHashCode) MA0002/MA0021 still enforce explicitness - those were fixed.
dotnet_diagnostic.MA0006.severity = none

# MA0016 (prefer returning collection abstraction): the repo already rejects the equivalent
# CA1002 guidance - concrete List<T>/arrays are the deliberate contract in the pipeline models.
dotnet_diagnostic.MA0016.severity = none
